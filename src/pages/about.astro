---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import PageCopy from '../components/PageCopy.astro';
import { getPage } from '../lib/content';
import site from '../data/site.json';

// "about the artist" is the artist's own approved text (src/content/pages/about.md).
// A separate artist statement (statement.md) appears only once it is marked approved.
const about = await getPage('about');
const statement = await getPage('statement');
const a = about?.data;
const lists = a
  ? ([
      ['publications', a.publications],
      ['exhibitions', a.exhibitions],
      ['press', a.press],
    ] as const).filter(([, items]) => items.length > 0)
  : [];
const hasSide = Boolean(a?.portrait || lists.length || a?.professionalContact);
---
<BaseLayout title="about" description={`About ${site.byline}, ${site.role}`} type="profile" image={a?.portrait} imageAlt={a?.portraitAlt}>
  <header class="page-head wrap">
    <span class="label">about</span>
    <h1>{site.byline}</h1>
    <p class="role">{site.role}</p>
  </header>

  <div class:list={['wrap', 'cols', { single: !hasSide }]}>
    <section aria-labelledby="about-h" data-reveal>
      <PageCopy id="about" headingAs="h2" headingId="about-h" class="about-copy" />
      {statement?.data.approved && (
        <PageCopy id="statement" headingAs="h2" class="statement-copy" />
      )}
    </section>

    {hasSide && (
      <div class="side">
        {a?.portrait && (
          <figure class="portrait">
            <ArtworkImage src={a.portrait} alt={a.portraitAlt ?? `Portrait of ${site.byline}`} sizes="(min-width: 60em) 30vw, 90vw" widths={[480, 720, 960]} />
          </figure>
        )}
        {lists.map(([name, items]) => (
          <section aria-labelledby={`${name}-h`}>
            <h2 id={`${name}-h`} class="label">{name}</h2>
            <ul class="facts">
              {items.map((it) => <li>{it.url ? <a href={it.url} rel="noopener">{it.text}</a> : it.text}</li>)}
            </ul>
          </section>
        ))}
        {a?.professionalContact && (
          <section aria-labelledby="pro-h">
            <h2 id="pro-h" class="label">professional enquiries</h2>
            <p class="pro">{a.professionalContact}</p>
            <p class="label"><a href="/contact/">contact form</a></p>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .role { margin: 1rem 0 0; font-family: var(--sans); font-size: 0.875rem; letter-spacing: 0.1em; color: var(--slate); }
  .cols { display: grid; gap: var(--space-4) var(--gutter); }
  @media (min-width: 60em) { .cols:not(.single) { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .cols :global(.about-copy) { max-width: 40rem; }
  .cols :global(.statement-copy) { margin-top: var(--space-4); max-width: 40rem; }
  .side { display: grid; gap: var(--space-3); align-content: start; }
  .side h2 { display: block; margin-bottom: 1.25rem; }
  .portrait { margin: 0; max-width: 26rem; }
  .facts { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .facts li { border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem; }
  .pro { white-space: pre-line; margin-bottom: 0.5rem; }
</style>
