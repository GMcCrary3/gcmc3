---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkImage from '../../components/ArtworkImage.astro';
import EditorialNote from '../../components/EditorialNote.astro';
import { getWriting, writingKinds, poemToHtml, type Writing } from '../../lib/content';
import { render } from 'astro:content';
import WorksForm from '../../components/WorksForm.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const all = await getWriting();
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry, all } }));
}
interface Props { entry: Writing; all: Writing[] }
const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const isPoem = d.kind === 'poetry';
const book = d.book ? all.find((w) => w.id === d.book) : undefined;
const contents = d.kind === 'book' ? all.filter((w) => w.data.book === entry.id) : [];
const facts = [
  ['year', d.year],
  ['publisher', d.publisher],
].filter(([, v]) => Boolean(v)) as [string, string][];
const kindLabel = d.kind === 'book' ? 'book' : d.kind === 'poetry' ? 'poem' : writingKinds[d.kind];
const description = d.description ?? `${d.title} — ${kindLabel} by giles c mccrary iii.`;
const r = site.works.responses;
const responsesOn = d.responses && r.open && r.poems.includes(entry.id);
const responseSlug = `responses/${entry.id}`;
---
<BaseLayout title={d.title} description={description} image={d.cover} imageAlt={d.coverAlt} type="article">
  <article class="wrap entry">
    {d.review && (
      <EditorialNote>
        Awaiting Giles's review. This page appears only on the private preview and is left
        out of any public build until it is approved (remove "review" in the editor).
      </EditorialNote>
    )}
    <header class="page-head">
      <a class="label" href="/writing/">writing · {kindLabel}</a>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
      {book && <p class="from">from <a href={`/writing/${book.id}/`}><em>{book.data.title}</em></a></p>}
      <p class="label by">giles c mccrary iii</p>
    </header>

    <div class="layout">
      {d.cover && (
        <div class="cover">
          <ArtworkImage src={d.cover} alt={d.coverAlt ?? `Cover of ${d.title}`} sizes="(min-width: 48em) 30vw, 80vw" widths={[400, 640, 960]} />
        </div>
      )}

      <div class="text">
        {d.description && <p class="lede">{d.description}</p>}

        {facts.length > 0 && (
          <dl class="facts">
            {facts.map(([k, v]) => (<div><dt class="label">{k}</dt><dd>{v}</dd></div>))}
          </dl>
        )}

        {d.audio && (
          <figure class="reading">
            <figcaption class="label">a reading, by the author</figcaption>
            <audio controls preload="none" src={d.audio}></audio>
          </figure>
        )}

        {hasBody && (isPoem
          ? <div class="poem reading-text" set:html={poemToHtml(entry.body!)} />
          : <div class="prose reading-text"><Content /></div>)}

        {contents.length > 0 && (
          <section class="contents" aria-labelledby="contents-h">
            <h2 id="contents-h" class="label">from this book, on this site</h2>
            <ul>{contents.map((c) => <li><a href={`/writing/${c.id}/`}>{c.data.title}</a></li>)}</ul>
          </section>
        )}

        {d.links.length > 0 && (
          <ul class="links">
            {d.links.map((l) => (<li><a href={l.url} rel="noopener">{l.label}</a></li>))}
          </ul>
        )}

        {(!d.description && !hasBody && contents.length === 0) && (
          <EditorialNote>
            Nothing has been written here yet, by design: no description, excerpt,
            publication details, or links are published until the author supplies them.
            Edit <code>src/content/writing/{entry.id}.md</code> or use the editor.
          </EditorialNote>
        )}
      </div>
    </div>
  </article>

  {responsesOn && (
    <section class="wrap responses" aria-labelledby="responses-h" data-responses data-project={responseSlug} data-copy={JSON.stringify(site.works.copy)}>
      <h2 id="responses-h">{r.heading}</h2>
      <ol class="response-list" data-response-list><li class="label">loading…</li></ol>
      <form class="report" data-report hidden>
        <p class="label">report response no. <span data-report-seq></span></p>
        <select aria-label="reason">
          <option value="hate">hateful</option>
          <option value="threat">threatening</option>
          <option value="personal information">someone's personal information</option>
          <option value="impersonation">impersonation</option>
          <option value="spam">spam</option>
          <option value="other">something else</option>
        </select>
        <button type="submit" class="text-btn">send report</button>
        <button type="button" class="text-btn" data-report-cancel>cancel</button>
        <span class="label" data-report-status aria-live="polite"></span>
      </form>
      <WorksForm project={responseSlug} prompt={r.prompt} maxChars={r.maxChars} rows={5} />
    </section>
  )}

  <script>
    import { load, report, setupForm } from '../../lib/works-client';
    const root = document.querySelector<HTMLElement>('[data-responses]');
    if (root) {
      const project = root.dataset.project!;
      const copy = JSON.parse(root.dataset.copy!);
      const list = root.querySelector<HTMLOListElement>('[data-response-list]')!;
      const form = root.querySelector<HTMLFormElement>('[data-report]')!;
      let seq = 0;
      const refresh = async () => {
        const res = await load(project);
        if (!res.ok) { list.replaceChildren(Object.assign(document.createElement('li'), { className: 'label', textContent: 'responses could not be loaded just now.' })); return; }
        const items = res.data.entries.filter((e) => !e.removed).map((e) => {
          const li = document.createElement('li');
          const p = Object.assign(document.createElement('p'), { className: 'words', textContent: e.text ?? '' });
          const meta = Object.assign(document.createElement('p'), { className: 'meta label', textContent: e.display ?? 'anonymous' });
          const b = Object.assign(document.createElement('button'), { type: 'button', className: 'text-btn', textContent: 'report' });
          b.setAttribute('aria-label', `report response ${e.seq}`);
          b.addEventListener('click', () => { seq = e.seq; form.hidden = false; form.querySelector('[data-report-seq]')!.textContent = String(e.seq); form.querySelector('select')!.focus(); });
          meta.append(' ', b);
          li.append(p, meta);
          return li;
        });
        list.replaceChildren(...(items.length ? items : [Object.assign(document.createElement('li'), { className: 'empty', textContent: copy.empty })]));
      };
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const r = await report(project, seq, form.querySelector('select')!.value);
        form.querySelector('[data-report-status]')!.textContent = r.ok ? 'reported. it will be read.' : 'could not send the report just now.';
      });
      form.querySelector('[data-report-cancel]')!.addEventListener('click', () => { form.hidden = true; });
      setupForm(project, copy, () => {}, () => void refresh());
      void refresh();
    }
  </script>
</BaseLayout>

<style>
  .page-head .label { text-decoration: none; }
  .page-head h1 { max-width: 18ch; }
  .subtitle { font-style: italic; font-size: 1.5rem; margin: 1rem 0 0; color: var(--ink-soft); }
  .from { margin: 1rem 0 0; color: var(--ink-soft); font-size: 1.25rem; }
  .by { margin: 1.5rem 0 0; }
  .layout { display: grid; gap: var(--space-3) var(--gutter); }
  @media (min-width: 48em) {
    .layout:has(.cover) { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  }
  .text { max-width: 38rem; }
  .cover { max-width: 24rem; }
  .lede { font-size: 1.5rem; line-height: 1.4; }
  .facts { margin: 0 0 2rem; display: grid; gap: 0.5rem; }
  .facts div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem; }
  .facts dd { margin: 0; }
  .reading { margin: 0 0 2rem; }
  .reading audio { width: 100%; margin-top: 0.5rem; }
  .reading-text { margin-top: 1rem; }
  .contents { margin-top: var(--space-3); }
  .contents ul { list-style: none; padding: 0; margin: 0.75rem 0 0; font-size: 1.375rem; display: grid; gap: 0.35rem; }
  /* Responses: below the work, clearly apart from it. */
  .responses { margin-top: var(--space-5); border-top: 1px solid var(--rule); padding-top: var(--space-3); display: grid; gap: var(--space-3); }
  .responses h2 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); }
  .response-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; max-width: 40rem; }
  .response-list :global(li) { border-left: 1px solid var(--rule); padding-left: 1rem; }
  .response-list :global(.words) { white-space: pre-wrap; margin: 0; font-size: 1.15rem; overflow-wrap: anywhere; }
  .response-list :global(.meta) { margin: 0.35rem 0 0; display: flex; gap: 1rem; align-items: baseline; }
  .response-list :global(.empty) { border: 0; padding: 0; font-style: italic; color: var(--slate); white-space: pre-line; }
  .report { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; }
  .report[hidden] { display: none; }
  .report select { font: inherit; font-family: var(--sans); font-size: 0.875rem; padding: 0.3rem; background: var(--ivory); border: 1px solid var(--slate); }
  .links { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0.5rem; font-family: var(--sans); font-size: 0.9375rem; }
</style>
