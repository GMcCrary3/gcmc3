---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkImage from '../../components/ArtworkImage.astro';
import EditorialNote from '../../components/EditorialNote.astro';
import {
  getArtworks, artworkAlt, artworkLabel, findMovementFor, movementAnchor, poemsPairedWith, type Artwork,
} from '../../lib/content';
import { originalUrl } from '../../lib/images';
import { render } from 'astro:content';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const list = await getArtworks();
  return list.map((work, i) => ({
    params: { id: work.id },
    props: { work, prev: list[i - 1], next: list[i + 1] },
  }));
}

interface Props { work: Artwork; prev?: Artwork; next?: Artwork }
const { work, prev, next } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const hasNote = Boolean(work.body?.trim());
const label = artworkLabel(work);
const original = originalUrl(d.image);
const movement = await findMovementFor(work.id);
const poems = await poemsPairedWith(work.id);

// Only fields that have been filled in are published.
const details = [
  ['catalogue', `no. ${d.ref}`],
  ['year', d.year],
  ['medium', d.medium],
  ['dimensions', d.dimensions],
  ['availability', site.showAvailability ? d.availability : undefined],
].filter(([, v]) => Boolean(v)) as [string, string][];

const missing = ['title', 'year', 'medium', 'dimensions', 'description'].filter((k) => !d[k as keyof typeof d]);
const description = d.title
  ? `${d.title}${d.year ? ` (${d.year})` : ''} — artwork by giles c mccrary iii.`
  : `Artwork no. ${d.ref} by giles c mccrary iii.`;
---
<BaseLayout title={label} description={description} image={d.image} imageAlt={artworkAlt(work)} type="article">
  <article class="artwork">
    <div class="plate wrap">
      {original ? (
        <a href={original} data-enlarge data-alt={artworkAlt(work)} data-caption={label} aria-label={`Enlarge ${label}`}>
          <ArtworkImage src={d.image} alt={artworkAlt(work)} sizes="(min-width: 64em) 70vw, 100vw" widths={[640, 960, 1280, 1600, 2000, 2600]} eager quality={90} />
        </a>
      ) : (
        <ArtworkImage src={d.image} alt={artworkAlt(work)} sizes="100vw" eager />
      )}
    </div>

    <div class="info wrap">
      <header>
        <a class="label" href="/artwork/">artwork archive</a>
        <h1 class:list={{ untitled: !d.title }}>{label}</h1>
        {movement && (
          <p class="in-ex">
            <a href={`/exhibition/#${movementAnchor(movement)}`}>
              <span class="label">in the exhibition</span>
              {movement.data.numeral} · {movement.data.title}
            </a>
          </p>
        )}
      </header>

      <div class="body">
        {details.length > 0 && (
          <dl class="details">
            {details.map(([k, v]) => (<div><dt class="label">{k}</dt><dd>{v}</dd></div>))}
          </dl>
        )}

        {d.description && <p class="description">{d.description}</p>}
        {hasNote && <div class="prose note"><Content /></div>}

        {missing.length > 0 && (
          <EditorialNote>
            Unpublished until supplied: {missing.join(', ')}. Nothing is filled in on the artist’s behalf.
          </EditorialNote>
        )}

        <p class="label actions">
          {original && <a href={original} data-enlarge data-alt={artworkAlt(work)} data-caption={label}>enlarge</a>}
          {original && <a href={original}>original file</a>}
          {site.showAvailability && d.availability && (
            <a href={`/contact/?about=${encodeURIComponent(label)}`}>enquire about this work</a>
          )}
        </p>

        {poems.length > 0 && (
          <section class="related" aria-label="Paired writing">
            <h2 class="label">paired in the exhibition with</h2>
            <ul>{poems.map((p) => <li><a href={`/writing/${p.id}/`}>{p.data.title}</a></li>)}</ul>
          </section>
        )}
      </div>
    </div>

    {d.parts.length > 0 && (
      <section class="parts wrap" aria-labelledby="parts-h">
        <h2 id="parts-h" class="label">{d.parts.length} works within this photograph</h2>
        <ol>
          {d.parts.map((p) => (
            <li>
              {p.image ? <ArtworkImage src={p.image} alt={p.alt ?? ''} sizes="(min-width: 48em) 30vw, 100vw" /> : null}
              {p.label && <span class="label">{p.label}</span>}
              {!p.image && p.alt && <p class="part-desc">{p.alt}</p>}
              {p.note && <p>{p.note}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    {d.details.length > 0 && (
      <section class="detail-images wrap" aria-labelledby="details-h">
        <h2 id="details-h" class="label">details</h2>
        <div class="detail-grid">
          {d.details.map((img) => (
            <figure>
              <ArtworkImage src={img.image} alt={img.alt ?? `Detail of ${label}`} sizes="(min-width: 48em) 45vw, 100vw" />
              {img.caption && <figcaption class="label">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <nav class="pager wrap" aria-label="Catalogue">
      {prev ? <a rel="prev" href={`/artwork/${prev.id}/`}><span class="label">previous</span>{artworkLabel(prev)}</a> : <span />}
      {next ? <a rel="next" class="next" href={`/artwork/${next.id}/`}><span class="label">next</span>{artworkLabel(next)}</a> : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .plate { padding-top: var(--space-3); display: flex; justify-content: center; }
  .plate a { display: block; cursor: zoom-in; }
  .plate :global(picture) { display: contents; }
  .plate :global(img) {
    width: auto;
    max-width: 100%;
    max-height: calc(100svh - 8rem);
    object-fit: contain;
    margin-inline: auto;
    background: transparent;
  }
  .plate :global(.art-missing) { max-width: 36rem; }

  .info { display: grid; gap: 1.5rem var(--gutter); padding-top: var(--space-3); }
  @media (min-width: 48em) { .info { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .info header > .label { text-decoration: none; display: block; margin-bottom: 0.75rem; }
  .info h1 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem); font-weight: 400; }
  .info h1.untitled { font-family: var(--sans); font-size: 1rem; letter-spacing: 0.1em; color: var(--ink-soft); }
  .in-ex { margin-top: 1.25rem; }
  .in-ex a { text-decoration: none; display: grid; gap: 0.15rem; font-size: 1.25rem; }
  .in-ex a:hover { color: var(--oxide); }

  .details { margin: 0 0 1.5rem; display: grid; gap: 0.6rem; max-width: var(--measure); }
  .details div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.6rem; }
  .details dd { margin: 0; }
  .description { max-width: var(--measure); font-size: 1.25rem; }
  .note { margin-bottom: 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .actions a:hover { color: var(--ink); }
  .related { margin-top: 2rem; }
  .related ul { list-style: none; padding: 0; margin: 0.5rem 0 0; font-size: 1.25rem; }

  .parts, .detail-images { padding-top: var(--space-4); }
  .parts ol { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 1.5rem var(--gutter); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .parts li { border-top: 1px solid var(--rule); padding-top: 0.75rem; }
  .part-desc { margin-top: 0.4rem; color: var(--ink-soft); }
  .detail-grid { display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); margin-top: 1rem; }
  .detail-grid figure { margin: 0; }

  .pager { display: flex; justify-content: space-between; gap: 1rem; padding-top: var(--space-4); }
  .pager a { text-decoration: none; display: grid; gap: 0.25rem; font-size: 1.125rem; }
  .pager a:hover { color: var(--oxide); }
  .pager .next { text-align: right; }
</style>
