---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import EditorialNote from '../../components/EditorialNote.astro';
import { getArtworks } from '../../lib/content';

const selected = await getArtworks('selected');
const archive = await getArtworks('archive');
---
<BaseLayout
  title="artwork"
  description="Selected works and an archive of process by giles c mccrary iii."
  image={selected[0]?.data.image}
  cropImage
>
  <header class="page-head wrap">
    <span class="label">artwork</span>
    <h1>selected works</h1>
  </header>

  <section class="wrap" aria-label="Selected works">
    <div class="gallery">
      {selected.map((w, i) => (
        <WorkCard
          work={w}
          eager={i === 0}
          sizes={i % 6 === 0 ? '(min-width: 48em) 64vw, 100vw' : '(min-width: 48em) 42vw, 100vw'}
        />
      ))}
    </div>
  </section>

  {archive.length > 0 && (
    <section class="archive wrap" aria-labelledby="archive-h">
      <div class="archive-head">
        <h2 id="archive-h">archive &amp; process</h2>
        <EditorialNote>
          Works here await the artist’s decision on final placement. To move one into
          selected works, set its collection to “selected” and give it an order number.
        </EditorialNote>
      </div>
      <div class="archive-grid">
        {archive.map((w) => (
          <WorkCard work={w} sizes="(min-width: 64em) 22vw, (min-width: 36em) 45vw, 100vw" />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .gallery {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 48em) {
    .gallery {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      row-gap: var(--space-5);
      align-items: start;
    }
    /* An irregular, editorial rhythm — every work shown whole, never cropped. */
    .gallery > :global(:nth-child(6n + 1)) { grid-column: 1 / span 8; }
    .gallery > :global(:nth-child(6n + 2)) { grid-column: 9 / span 4; margin-top: var(--space-5); }
    .gallery > :global(:nth-child(6n + 3)) { grid-column: 2 / span 5; }
    .gallery > :global(:nth-child(6n + 4)) { grid-column: 8 / span 5; margin-top: var(--space-4); }
    .gallery > :global(:nth-child(6n + 5)) { grid-column: 1 / span 6; }
    .gallery > :global(:nth-child(6n + 6)) { grid-column: 8 / span 4; margin-top: var(--space-5); }
  }

  .archive { padding-top: var(--space-5); }
  .archive-head {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-bottom: var(--space-3);
  }
  .archive-head h2 {
    font-family: var(--sans);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    font-weight: 450;
  }
  .archive-grid {
    display: grid;
    gap: var(--space-3) var(--gutter);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    align-items: start;
  }
</style>
