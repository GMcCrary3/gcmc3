---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import PageCopy from '../components/PageCopy.astro';
import { getArtworks, getWriting, getMovements, artworkAlt, movementAnchor, movementRange } from '../lib/content';
import site from '../data/site.json';

const all = await getArtworks();
const works = new Map(all.map((w) => [w.id, w]));
const heroWork = works.get(site.hero.artwork) ?? all[0];
const { movements } = await getMovements();
const books = (await getWriting()).filter((w) => w.data.kind === 'book');
---
<BaseLayout image={heroWork?.data.image} imageAlt={heroWork ? artworkAlt(heroWork) : undefined} cropImage>
  <section class="opening" aria-labelledby="concept">
    {heroWork && (
      <div class="opening-art">
        <ArtworkImage
          src={heroWork.data.image}
          alt={artworkAlt(heroWork)}
          sizes="100vw"
          widths={[640, 960, 1280, 1600, 2000, 2400]}
          crop
          focus={site.hero.focus}
          eager
          quality={85}
        />
      </div>
    )}
    <div class="opening-text wrap">
      <div class="identity">
        <h1 id="concept">{site.concept}.</h1>
        <p class="secondary">{site.secondaryLine}</p>
      </div>
      <div class="invitation">
        <blockquote class="statement"><p>{site.openingStatement}</p></blockquote>
        <p class="actions">
          <a class="btn primary" href="/exhibition/">{site.enterLabel} <span aria-hidden="true">→</span></a>
          <a class="btn" href="/artwork/">{site.exploreLabel}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="intro wrap" aria-label="Introduction">
    <div data-reveal><PageCopy id="home" headingAs="h2" class="home-copy" /></div>
  </section>

  <section class="movements wrap" aria-labelledby="movements-h">
    <div class="section-head">
      <h2 id="movements-h">the exhibition, in five movements</h2>
      <a class="label" href="/exhibition/">begin</a>
    </div>
    <ol class="mv-list">
      {movements.map((m) => (
        <li data-reveal>
          <a href={`/exhibition/#${movementAnchor(m)}`}>
            <span class="num">{m.data.numeral}</span>
            <span class="t">{m.data.title}</span>
            {movementRange(m, works) && <span class="label">{movementRange(m, works)}</span>}
          </a>
        </li>
      ))}
    </ol>
  </section>

  {site.field.open && (
    <section class="participation wrap" aria-labelledby="participation-h">
      <div class="section-head">
        <h2 id="participation-h">{site.field.label}</h2>
      </div>
      <a class="invite" href="/field/" data-reveal>
        <span class="t">{site.field.title}</span>
        <span class="inv">{site.field.invitation}</span>
      </a>
      <p class="label"><a href="/abstract/">{site.abstractRoom.title}</a></p>
    </section>
  )}

  {books.length > 0 && (
    <section class="writing wrap" aria-labelledby="writing-h">
      <div class="section-head">
        <h2 id="writing-h">writing</h2>
        <a class="label" href="/writing/">all writing</a>
      </div>
      <ul class="book-list">
        {books.map((b) => (
          <li data-reveal>
            <a href={`/writing/${b.id}/`}>{b.data.title}</a>
            {b.data.year && <span class="label">{b.data.year}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /* A full-viewport opening: the painting above, the words below — never on top. */
  .opening {
    display: flex;
    flex-direction: column;
  }
  .opening-art {
    height: 46svh;
    min-height: 16rem;
  }
  .opening-art :global(picture) { display: block; height: 100%; }
  .opening-text {
    display: grid;
    gap: 1.75rem;
    padding-block: 1.75rem 0.5rem;
  }
  .identity h1 {
    font-size: clamp(3rem, 1.5rem + 7vw, 8.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.92;
  }
  .secondary {
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem);
    color: var(--ink-soft);
    margin: 0.6rem 0 0;
  }
  .statement {
    margin: 0;
    font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem);
    line-height: 1.25;
    max-width: 28ch;
  }
  .statement p { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0 0; }

  @media (min-width: 64em) {
    .opening { height: calc(100svh - 5.5rem); min-height: 36rem; }
    .opening-art { flex: 1; height: auto; min-height: 0; }
    .opening-text {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--gutter);
      padding-block: 1.5rem 2rem;
    }
    /* Size the words by the viewport height so the whole opening fits on screen. */
    .identity h1 { font-size: clamp(3.25rem, 10.5vh, 8rem); }
    .secondary { font-size: clamp(1.3rem, 3.4vh, 2rem); }
    .statement { font-size: clamp(1.3rem, 3.4vh, 2rem); }
    .actions { margin-top: 1rem; }
  }

  .intro { padding-top: var(--space-4); }
  .intro > div { max-width: 40rem; margin-left: auto; margin-right: 12%; }
  @media (max-width: 59.99em) { .intro > div { margin-right: 0; margin-left: 0; } }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    margin-bottom: 1rem;
  }
  .section-head h2 {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 450;
  }
  .section-head a { text-decoration: none; }
  .section-head a:hover { color: var(--ink); }

  .movements { padding-top: var(--space-5); }
  .mv-list { list-style: none; padding: 0; margin: 0; }
  .mv-list li { border-bottom: 1px solid var(--rule); }
  .mv-list a {
    display: grid;
    grid-template-columns: clamp(3rem, 8vw, 6rem) 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    text-decoration: none;
  }
  .mv-list .num { color: var(--oxide); font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem); }
  .mv-list .t { font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.75rem); line-height: 1.1; }
  .mv-list a:hover .t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }

  .participation { padding-top: var(--space-5); }
  .invite { display: grid; gap: 0.9rem; text-decoration: none; padding-block: 1rem 1.5rem; }
  .invite .t { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.75rem); line-height: 1.05; }
  .invite .inv { white-space: pre-line; font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem); font-style: italic; color: var(--ink-soft); max-width: 40ch; line-height: 1.4; }
  .invite:hover .t { color: var(--oxide); }
  .participation .label a { text-decoration: none; font-size: 0.875rem; }

  .writing { padding-top: var(--space-5); }
  .book-list { list-style: none; margin: 0; padding: 0; }
  .book-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }
  .book-list a {
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.75rem);
    line-height: 1.15;
    text-decoration: none;
  }
  .book-list a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
</style>
