---
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  /** Content path of an image to use for social sharing. */
  image?: string;
  imageAlt?: string;
  /** Crop to 1200×630 (hero/default) or keep the full composition (artwork pages). */
  cropImage?: boolean;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  imageAlt,
  cropImage = false,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.byline}` : `${site.byline} — ${site.concept}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

let ogUrl = new URL('/og-default.png', Astro.site).href;
let ogWidth = 1200;
let ogHeight = 630;
let ogAlt = `${site.byline} — ${site.concept}`;

const resolved = resolveImage(image);
if (resolved) {
  const og = cropImage
    ? await getImage({ src: resolved, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 85 })
    : await getImage({ src: resolved, width: Math.min(1200, resolved.width), format: 'jpg', quality: 85 });
  ogUrl = new URL(og.src, Astro.site).href;
  ogWidth = Number(og.attributes.width);
  ogHeight = Number(og.attributes.height);
  ogAlt = imageAlt ?? ogAlt;
}

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.byline,
  url: Astro.site?.href,
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={site.siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={ogAlt} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={ogAlt} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
